# Poker Ledger environment variables — NEVER commit real values.
# Use separate Preview and Production values in Vercel.
# See README.md (Operations) for rotation and deploy instructions.

# Neon Postgres connection string (postgres.js driver).
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Group password hash — generate with: node scripts/hash-password.mjs
# Format: scrypt$16384$8$1$<salt_b64url>$<hash_b64url>
POKER_PASSWORD_HASH=scrypt$16384$8$1$replace-with-generated-salt$replace-with-generated-hash

# At least 32 random bytes (e.g. openssl rand -base64 32)
POKER_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Bump to invalidate ALL existing cookies (do this after suspected password sharing).
POKER_AUTH_VERSION=1

# Admin PIN/password hash — separate from the group password. Same scrypt format.
POKER_ADMIN_PASSWORD_HASH=scrypt$16384$8$1$replace-with-generated-salt$replace-with-generated-hash
POKER_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Resend (email). Optional: if unset, receipts are queued as failed and can be retried after config.
RESEND_API_KEY=re_...
# Shared secret used to verify Resend webhook signatures.
RESEND_WEBHOOK_SECRET=replace-with-a-long-random-string

POKER_EMAIL_FROM=Poker Ledger <poker@amitkonda.com>
# Optional: admin address notified when a dispute is opened (no account system exists).
POKER_ADMIN_NOTIFY_EMAIL=
PUBLIC_APP_ORIGIN=https://amitkonda.com
